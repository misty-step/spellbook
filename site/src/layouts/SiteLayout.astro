---
import '@misty-step/brand/brand.css';
import '@misty-step/brand/spine.css';
import '../styles/site.css';
import { HTML_ATTRS } from '@misty-step/brand/attrs';
import { MARK_SVG } from '@misty-step/brand/mark';
import { icon } from '@misty-step/brand/spine';
import faviconSvg from '@misty-step/brand/identity/icons/favicon.svg?url';
import favicon32 from '@misty-step/brand/identity/icons/favicon-32.png?url';
import appIcon from '@misty-step/brand/identity/icons/app-180-ink.png?url';
import ogCard from '../assets/og-spellbook.png?url';
import { home } from '../copy/home.mjs';
import { canonical, release, repositoryUrl } from '../lib/release.mjs';
const links = [
  { href: '/library/', label: 'Skills' },
  { href: '/library/core/', label: 'Core' },
  { href: '/tools/misty-check/', label: 'misty-check' },
  { href: '/philosophy/', label: 'Philosophy' },
  { href: '/search/', label: 'Search' },
];
const {
  title,
  description = 'Active Folio method: six always-on rules, seven lean skills, and deterministic scripts for coding agents.',
  section = 'About',
  path = Astro.url.pathname,
  noindex = false,
  nav = links,
  navCta = { href: '/#install', label: 'Install' },
} = Astro.props;
const more = [
  { href: '/#install', label: 'Install' },
  { href: '/find/', label: 'Find a skill' },
  { href: repositoryUrl, label: 'GitHub' },
];
const footer = [
  { href: 'https://mistystep.io', label: 'Misty Step' },
  { href: repositoryUrl, label: 'GitHub' },
  ...links,
  { href: '/find/', label: 'Find a skill' },
];
const selected = (href) => (href !== '/' && !href.startsWith('/#') && path.startsWith(href) ? 'page' : undefined);
const fullTitle = title === 'spellbook' ? title : `${title} | spellbook`;
// @misty-step/brand 0.3.0 locks lockup() to "Misty Step" and "mistystack"; compose the same
// .ms-lockup markup from its mark until the brand package names spellbook.
const masthead = `<a class="ms-lockup" href="/" aria-label="spellbook home">${MARK_SVG}<span class="ms-name">spellbook</span></a>`;
const url = new URL(path, canonical);
---
<!doctype html>
<html lang="en" {...HTML_ATTRS}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme-init.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta data-pagefind-filter="section[content]" content={section} />
    <meta data-pagefind-meta="title[content]" content={title} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="icon" href={favicon32} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={appIcon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="spellbook" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(ogCard, canonical)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="sp-skip" href="#main">Skip to content</a>
    <header class="masthead" data-pagefind-ignore>
      <div class="frame masthead-bar">
        <Fragment set:html={masthead} />
        <nav class="masthead-links" aria-label="Primary">
          {nav.map((link) => <a href={link.href} aria-current={selected(link.href)}>{link.label}</a>)}
        </nav>
        <div class="masthead-actions">
          <button class="sp-ghost sp-icon-only" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark theme"><Fragment set:html={icon('moon')} /></button>
          <a class="sp-button masthead-cta" href={navCta.href}>{navCta.label}</a>
          <details class="nav-menu">
            <summary class="sp-secondary">Menu</summary>
            <nav aria-label="Menu">
              <ul role="list">
                {[...links, ...more].map((link) => <li><a href={link.href} aria-current={selected(link.href)}>{link.label}</a></li>)}
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1" data-pagefind-body={!noindex || undefined} data-pagefind-ignore={noindex ? 'all' : undefined}><slot /></main>
    <footer class="site-foot" data-pagefind-ignore>
      <div class="frame site-foot-grid">
        <p class="site-foot-line">{home.footer.line}</p>
        <nav class="site-foot-links" aria-label="Footer">{footer.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
        <p class="site-foot-release">Site source <a class="sp-link" href={`${repositoryUrl}/tree/${release.commit}`}><code>{release.commit.slice(0, 7)}</code></a> · Method package <span class="site-foot-version">{release.version}</span> · <a class="sp-link" href="/release.json">Release record</a></p>
      </div>
    </footer>
    <script>import '../scripts/site.mjs';</script>
  </body>
</html>
