---
import { TOOL_SCRIPTS } from '../lib/graph.mjs';
const { document, graph, toc = false, activeUrl } = Astro.props;
const headings = document ? document.headings.filter((heading) => heading.depth > 1 && heading.depth < 4) : [];
const skills = graph.documents.filter((item) => item.kind === 'Skills');
const currentUrl = activeUrl ?? document?.url;
---
{toc ? (
  <nav class="doc-nav" aria-label="On this page">
    <ul class="doc-nav-list" role="list">
      {headings.map((heading) => <li data-depth={heading.depth}><a href={`#${heading.id}`}>{heading.label}</a></li>)}
    </ul>
  </nav>
) : (
  <nav class="doc-nav" aria-label="Method navigation">
    <ul class="doc-nav-list" role="list">
      <li><a href="/library/" aria-current={currentUrl === '/library/' ? 'page' : undefined}>All skills ({skills.length})</a></li>
      <li><a href="/library/core/" aria-current={currentUrl === '/library/core/' ? 'page' : undefined}>Always-on core</a></li>
      {TOOL_SCRIPTS.map((tool) => (
        <li><a href={tool.url} aria-current={currentUrl === tool.url ? 'page' : undefined}>{tool.name}</a></li>
      ))}
      <li><a href="/philosophy/" aria-current={currentUrl === '/philosophy/' ? 'page' : undefined}>Philosophy &amp; Lineage</a></li>
    </ul>
    <p class="doc-nav-heading">Skills</p>
    <ul class="doc-nav-list" role="list">
      {skills.map((item) => (
        <li><a href={item.url} aria-current={item.url === currentUrl ? 'page' : undefined}>{item.skill.name}</a></li>
      ))}
    </ul>
  </nav>
)}
