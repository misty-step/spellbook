---
const { document } = Astro.props;
const skill = document.skill;
---
{skill && (
  <section class="skill-metadata" aria-label="Skill metadata">
    <dl>
      <div><dt data-pagefind-ignore>Skill name</dt><dd><p><code class="sp-code-inline">{skill.name}</code></p></dd></div>
      <div><dt data-pagefind-ignore>When to use</dt><dd><p>{skill.description}</p></dd></div>
      <div><dt data-pagefind-ignore>Size</dt><dd><p>{skill.words} words</p></dd></div>
      {skill.script && (
        <div>
          <dt data-pagefind-ignore>Script</dt>
          <dd><p><a class="sp-link" href={skill.script.url}><code class="sp-code-inline">{skill.script.path}</code></a></p></dd>
        </div>
      )}
    </dl>
  </section>
)}
