---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import DocNavigation from '../../../components/DocNavigation.astro';
import HeadlineText from '../../../components/HeadlineText.astro';
import { getGraph } from '../../../lib/content.mjs';
import { TOOL_SCRIPTS } from '../../../lib/graph.mjs';
import { blobUrl, encodePath, release, repoRoot } from '../../../lib/release.mjs';
import { format, RULES, scan } from '../../../../../skills/design/scripts/slop-check.mjs';

const graph = await getGraph();
const tool = TOOL_SCRIPTS.find((item) => item.id === 'slop-check');
const source = readFileSync(path.join(repoRoot, tool.path), 'utf8');
const lineCount = source.split('\n').length - (source.endsWith('\n') ? 1 : 0);
const fixtures = path.join(repoRoot, 'skills/design/scripts/fixtures');
const slop = format(scan(['left-border-slop'], { cwd: fixtures }));
const calm = format(scan(['calm-editorial'], { cwd: fixtures }));
---
<SiteLayout title="slop-check.mjs" description={tool.summary} section="Tools" path={tool.url}>
  <div class="frame docs-shell">
    <aside class="docs-sidebar" data-pagefind-ignore><DocNavigation {graph} activeUrl={tool.url} /></aside>
    <article class="docs-content">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore><a class="sp-link" href="/">Home</a> / <a class="sp-link" href="/library/skills/design/">Design</a> / <span>slop-check.mjs</span></nav>
      <details class="docs-disclosure browse-mobile" data-pagefind-ignore><summary>Browse method</summary><DocNavigation {graph} activeUrl={tool.url} /></details>
      <header class="doc-header">
        <h1 class="page-title"><HeadlineText text="slop-check.mjs" stop /></h1>
        <p class="doc-lede">{tool.summary}</p>
        <p class="doc-note">{tool.language} · {lineCount} lines · {Object.keys(RULES).length} rules · Zero npm dependencies.</p>
      </header>
      <div class="source-provenance" data-pagefind-ignore>
        <p><code class="sp-code-inline">{tool.path}</code></p>
        <a class="sp-link" href={blobUrl(tool.path)}>Source at <code class="sp-code-inline">{release.commit.slice(0, 7)}</code></a> · <a class="sp-link" href={`/source/${encodePath(tool.path)}`}>Raw script</a> · <a class="sp-link" href="/library/skills/design/">Design skill</a>
      </div>
      <div class="doc-body prose">
        <h2 id="usage">Usage</h2>
        <pre class="sp-code" tabindex="0"><code>{`node ${tool.path} src/styles src/pages
node ${tool.path} dist --json`}</code></pre>
        <p>Exit <code class="sp-code-inline">0</code> clean, <code class="sp-code-inline">1</code> findings, <code class="sp-code-inline">2</code> usage or read error. A file opts out of one rule with a justified comment: <code class="sp-code-inline">slop-check-allow: side-stripe -- printed pull-quote rule</code>.</p>
        <h2 id="rules">Rules</h2>
        <table>
          <thead><tr><th scope="col">Rule</th><th scope="col">Flags</th></tr></thead>
          <tbody>{Object.entries(RULES).map(([id, text]) => <tr><td><code class="sp-code-inline">{id}</code></td><td>{text}</td></tr>)}</tbody>
        </table>
        <h2 id="slop-fixture">Against the left-border slop fixture</h2>
        <p>Live build-time output for <code class="sp-code-inline">skills/design/scripts/fixtures/left-border-slop</code>: a card with a violet accent stripe and the usual generated-UI defaults.</p>
        <pre class="sp-code" tabindex="0"><code>{slop}</code></pre>
        <h2 id="calm-fixture">Against the Calm Editorial fixture</h2>
        <p>The same rules against <code class="sp-code-inline">skills/design/scripts/fixtures/calm-editorial</code>: tokens, one accent, a typographic quotation rule, full button states and a reduced-motion variant.</p>
        <pre class="sp-code" tabindex="0"><code>{calm}</code></pre>
        <h2 id="source">Full source</h2>
        <pre class="sp-code source-viewer" tabindex="0"><code>{source}</code></pre>
      </div>
    </article>
  </div>
</SiteLayout>
