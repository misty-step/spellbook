---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeadlineText from '../components/HeadlineText.astro';
import { getGraph } from '../lib/content.mjs';
import { getHome } from '../lib/home.mjs';
import '../styles/home.css';
const page = getHome(await getGraph());
const { hero, sections: { skills, core, check, install, philosophy } } = page;
---
<SiteLayout title={page.title} description={hero.sub} nav={page.nav} navCta={page.navCta}>
  <div class="frame">
    <section class="hero">
      <h1><HeadlineText text={hero.headline} /></h1>
      <p class="hero-sub">{hero.sub}</p>
      <div class="actions">
        <a class="sp-button" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="sp-secondary" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
      <p class="hero-proof">{hero.proof}</p>
    </section>

    <section class="home-section" id="skills">
      <div class="section-head">
        <h2><HeadlineText text={skills.title} /></h2>
        <p class="section-intro">{skills.intro}</p>
      </div>
      <ol class="skill-grid" role="list">
        {skills.items.map((item) => (
          <li class="sp-card skill-card">
            <div class="skill-card-head">
              <span class="skill-index">{item.index}</span>
              {item.script && <a class="sp-tag skill-script-tag" href={item.script.url}>+ {item.script.name}</a>}
            </div>
            <h3 class="skill-card-title"><a class="sp-link" href={item.url}>{item.name}</a></h3>
            <p class="skill-card-desc">{item.description}</p>
            <div class="skill-card-foot">
              <code class="skill-path">{item.id}</code>
              <a class="sp-link skill-read" href={item.url}>Read</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-section home-split" id="core">
      <div class="section-head">
        <h2><HeadlineText text={core.title} /></h2>
        <p class="section-intro">{core.intro}</p>
        <div class="actions"><a class="sp-secondary" href={core.source.href}>Read {core.source.label}</a></div>
      </div>
      <figure class="core-figure">
        <pre class="sp-code core-code" tabindex="0"><code>{core.lines.join('\n')}</code></pre>
        <figcaption>{core.caption} <a class="sp-link" href={core.source.href}>{core.source.label}</a> at <a class="sp-link" href={core.commitUrl}><code>{core.commit}</code></a>.</figcaption>
      </figure>
    </section>

    <section class="home-section home-split" id="check">
      <div class="section-head">
        <h2><HeadlineText text={check.title} /></h2>
        <p class="section-intro">{check.intro}</p>
        <div class="actions">
          <a class="sp-button" href={check.primary.href}>{check.primary.label}</a>
          <a class="sp-secondary" href={check.secondary.href}>{check.secondary.label}</a>
        </div>
      </div>
      <figure class="core-figure">
        <pre class="sp-code check-sample" tabindex="0"><code>{check.sample}</code></pre>
        <figcaption>Live build-time output of <a class="sp-link" href="/tools/misty-check/"><code>misty-check.mjs</code></a> against this repository.</figcaption>
      </figure>
    </section>

    <section class="home-section home-split" id="install">
      <div class="section-head">
        <h2><HeadlineText text={install.title} /></h2>
        <p class="section-intro">{install.intro}</p>
      </div>
      <div class="install">
        <div class="sp-tabs" role="tablist" aria-label="Choose your harness">
          {install.tabs.map((tab, index) => (
            <button type="button" role="tab" class="sp-tab" id={`install-tab-${tab.id}`} aria-controls={`install-panel-${tab.id}`} aria-selected={String(index === 0)} tabindex={index === 0 ? 0 : -1}>{tab.name}</button>
          ))}
        </div>
        {install.tabs.map((tab, index) => (
          <div class="sp-tabpanel install-panel" role="tabpanel" id={`install-panel-${tab.id}`} aria-labelledby={`install-tab-${tab.id}`} hidden={index !== 0}>
            <div class="install-command">
              <pre class="sp-code" tabindex="0" aria-label={`${tab.name} install commands`}><code>{tab.lines.join('\n')}</code></pre>
              <button class="sp-secondary copy" type="button" data-copied={install.copied} data-failed={install.copyFailed}>{install.copy}</button>
            </div>
            <p class="install-note">{tab.note}</p>
          </div>
        ))}
        <span class="sp-sr" role="status" data-copy-status></span>
      </div>
    </section>

    <section class="home-section home-close" id="philosophy">
      <h2><HeadlineText text={philosophy.title} /></h2>
      <p class="section-intro">{philosophy.body}</p>
      <div class="actions">
        <a class="sp-button" href={philosophy.primary.href}>{philosophy.primary.label}</a>
        <a class="sp-secondary" href={philosophy.secondary.href}>{philosophy.secondary.label}</a>
      </div>
    </section>
  </div>
</SiteLayout>
